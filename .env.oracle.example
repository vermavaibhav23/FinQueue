# Copy to .env.oracle; never commit the populated file.
SITE_ADDRESS=finqueue.example.com
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=finqueue.example.com

MYSQL_DATABASE=finqueue
MYSQL_USER=finqueue_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
MYSQL_HOST=db
MYSQL_PORT=3306

REDIS_URL=redis://redis:6379/0
